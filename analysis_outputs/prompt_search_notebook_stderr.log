            },
            {
                "name": "hard_negative_v2",
                "description": "Больше hard negatives, чтобы не потерять specificity",
                "builder": prompt_hard_negative,
            },
        ]

        display(pd.DataFrame([{k: v for k, v in item.items() if k != "builder"} for item in PROMPT_VARIANTS]))
