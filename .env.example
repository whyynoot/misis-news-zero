# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
DATABASE_ENGINE=postgresql
POSTGRES_DB=news_analyzer
POSTGRES_USER=news_analyzer
POSTGRES_PASSWORD=news_analyzer
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONNECT_TIMEOUT=10
# DATABASE_ENGINE=sqlite
# SQLITE_DATABASE_PATH=db.sqlite3

# Logging
DJANGO_LOG_LEVEL=INFO
HF_CACHE_DIR=./.cache/huggingface
HF_TOKEN=
USE_CUDA=False
MODEL_BATCH_SIZE=8

# Local LLM / Ollama
LLM_ENABLED=False
LLM_BASE_URL=http://localhost:11434
LLM_DOCKER_BASE_URL=http://host.docker.internal:11434
LLM_API_KEY=
LLM_MODEL=gemma4:e2b
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048
LLM_NUM_CTX=0
LLM_BATCH_NEWS_SIZE=1
LLM_CONCURRENCY=1
LLM_THINK=False
LLM_PROMPT_VERSION=

# Monitoring backfill
NEWS_SOURCES=tass,interfax
INTERFAX_SECTIONS=russia,business,world
INTERFAX_HYDRATE_ARTICLES=True
MONITORING_HISTORY_BACKFILL_LIMIT=5000
MONITORING_LIVE_NEWS_LIMIT=50
MONITORING_BACKFILL_SOURCE=
MONITORING_EXCLUDE_SEED=True
MONITORING_HISTORY_DAYS=365
MONITORING_HISTORY_SOURCES=interfax
MONITORING_HISTORY_LIMIT_PER_DAY=8
MONITORING_UPDATE_INTERVAL_HOURS=4

# Production Settings (set DEBUG=False in production)
# DEBUG=False
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com 
